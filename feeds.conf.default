# External source feeds checked out into submodules/ by scripts/feeds.
#
# Copy this file to feeds.conf to override it locally; feeds.conf is ignored by
# Git and takes precedence when present.
#
# <branch> may also be a tag or a full 40-hex commit id; an abbreviated id is
# not accepted by the server, so pin with the full id.
#
# Format, one feed per line:
#   src-git <name> <url>;<branch> [nested submodule paths, comma separated]
#
# <name> is the directory created under submodules/. The checkout tracks the
# branch head: scripts/feeds update fetches the branch and fast-forwards the
# working copy to it. Nested submodules are initialized shallowly, one level at
# a time; every path not listed here stays uninitialized, which is how FEX's
# multi-gigabyte prebuilt test-binary repositories are kept out of the tree.

src-git fex-arm64ec https://github.com/eotics-com/FEX.git;main-ros External/Catch2,External/Vulkan-Headers,External/drm-headers,External/fmt,External/jemalloc_glibc,External/range-v3,External/rpmalloc,External/tracy,External/unordered_dense,External/vixl,External/xxhash,External/zydis,External/zydis/dependencies/zycore,Source/Common/cpp-optparse

# Pinned to a commit, not the branch head: ros-dev moves and its 2026-11-11 head adds
# Crocus d3dkmt sources that include drivers/directx/hdgfx_umd.h, which this tree
# does not have (CI broke with "file not found"). The previous pin 44504d1036b6 no
# longer exists upstream; ced09069ca78 is the last ros-dev commit before the Crocus
# D3DKMT winsys. Raise it only together with the matching in-tree header.
src-git mesa https://github.com/eotics-com/reactos-mesa.git;ced09069ca78ff18c998918902ccf0dc6beaed8b

# Pinned to a release tag; the build configures it for LGPL use only.
src-git ffmpeg https://github.com/FFmpeg/FFmpeg.git;n8.1.3

# Pinned to a monthly release tag; its dependencies are vendored in external/.
src-git felix86 https://github.com/OFFTKP/felix86.git;26.10

# Pinned to a release tag. Only dxilconv is built; the host TableGen build of a
# Linux host still configures SPIR-V, so its two submodules are checked out.
src-git dxc https://github.com/microsoft/DirectXShaderCompiler.git;v1.10.2605.37 external/SPIRV-Headers,external/SPIRV-Tools
